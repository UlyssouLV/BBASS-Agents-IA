MISTRAL_API_KEY=
VM_ADMIN_KEY=
VM_CENTRALE_HOST=0.0.0.0
VM_CENTRALE_PORT=8000
VM_CENTRALE_DATABASE_URL=postgresql+psycopg://vm_centrale:vm_centrale@localhost:5432/vm_centrale
VM_CENTRALE_PIECES_JOINTES_DIR=./pieces_jointes
MISTRAL_HTTP_TIMEOUT=30
VM_CENTRALE_SEARXNG_URL=http://localhost:8888
MODULEO_URL=https://mwa-bbass.kipaware.fr/api
# Clé d'API et SecurityCode Moduléo chiffrés (Fernet, spec 1.5.0, ADR-0017) :
# `python scripts/chiffrer_secret.py MODULEO_API_KEY_CHIFFREE` (puis
# MODULEO_SECURITY_CODE_CHIFFRE) crée la clé maître si besoin et imprime la
# ligne à coller ici. VM_CLE_MAITRE_FICHIER : chemin de la clé maître, hors
# du dépôt. Un élément vide ou indéchiffrable : outils Moduléo non proposés.
MODULEO_API_KEY_CHIFFREE=
MODULEO_SECURITY_CODE_CHIFFRE=
VM_CLE_MAITRE_FICHIER=
