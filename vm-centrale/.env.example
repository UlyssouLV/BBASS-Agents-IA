VM_ADMIN_KEY=
VM_CENTRALE_HOST=0.0.0.0
VM_CENTRALE_PORT=8000
VM_CENTRALE_DATABASE_URL=postgresql+psycopg://vm_centrale:vm_centrale@localhost:5432/vm_centrale
VM_CENTRALE_PIECES_JOINTES_DIR=./pieces_jointes
MISTRAL_HTTP_TIMEOUT=30
VM_CENTRALE_SEARXNG_URL=http://localhost:8888
MODULEO_URL=https://mwa-bbass.kipaware.fr/api
# Écriture Moduléo (spec 1.5.2, ADR-0019) : 1 pour l'activer, sur la VM de
# dev seulement. Rien ne part tant que MODULEO_URL n'est pas un serveur de
# test listé dans src/vm_centrale/moduleo/serveurs_test.json (jamais le
# serveur du cabinet ci-dessus). Absent = inactif. Procédure d'accès au
# serveur de test : README de src/vm_centrale/moduleo/.
MODULEO_ECRITURE=
# Secrets chiffrés (Fernet, spec 1.5.0 et 1.5.1, ADR-0017 et ADR-0018) :
# `python scripts/chiffrer_secret.py <VARIABLE>` crée la clé maître si
# besoin et imprime la ligne à coller ici. VM_CLE_MAITRE_FICHIER : chemin de
# la clé maître, hors du dépôt, obligatoire.
VM_CLE_MAITRE_FICHIER=
# Clé d'API Mistral chiffrée (MISTRAL_API_KEY en clair n'est plus lue) :
# absente ou indéchiffrable, la VM refuse de démarrer.
MISTRAL_API_KEY_CHIFFREE=
# Clé d'API et SecurityCode Moduléo : un élément vide ou indéchiffrable,
# la VM démarre sans les outils Moduléo.
MODULEO_API_KEY_CHIFFREE=
MODULEO_SECURITY_CODE_CHIFFRE=
