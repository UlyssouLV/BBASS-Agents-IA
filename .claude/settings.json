{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/gate-code-review.py || py -3 .claude/hooks/gate-code-review.py",
            "statusMessage": "Vérifie que /code-review est bien demandé"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/bloque-ecriture-moduleo.py || py -3 .claude/hooks/bloque-ecriture-moduleo.py",
            "statusMessage": "Refuse une écriture HTTP vers Moduléo"
          }
        ]
      }
    ]
  }
}
