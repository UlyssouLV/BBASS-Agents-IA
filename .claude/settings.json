{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["-3", ".claude/hooks/gate-code-review.py"],
            "statusMessage": "Vérifie que /code-review est bien demandé"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["-3", ".claude/hooks/gate-poste-sans-mistral.py"],
            "statusMessage": "Le poste n'appelle pas Mistral"
          }
        ]
      }
    ]
  }
}
