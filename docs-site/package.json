{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generer-changelog": "node scripts/generer-changelog.mjs",
    "generer-feuille-de-route": "node scripts/generer-feuille-de-route.mjs",
    "generer-bugs": "node scripts/generer-bugs.mjs",
    "generer-accueil": "npm run generer-changelog && npm run generer-feuille-de-route && npm run generer-bugs",
    "copier-doc-moduleo": "node scripts/copier-doc-moduleo.mjs",
    "compiler-css-poste": "node scripts/compiler-css-poste.mjs",
    "prestart": "npm run compiler-css-poste && npm run generer-accueil && npm run copier-doc-moduleo",
    "prebuild": "npm run compiler-css-poste && npm run generer-accueil && npm run copier-doc-moduleo",
    "start": "node scripts/start-local.mjs",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 4173",
    "capturer-accueil": "node scripts/capturer-accueil.mjs",
    "capturer-bugs": "node scripts/capturer-bugs.mjs",
    "capturer-travail-realise": "node scripts/capturer-travail-realise.mjs",
    "sync-architecture-readme": "node scripts/sync-architecture-readme.mjs",
    "generer-stats-commits": "node scripts/generer-stats-commits.mjs",
    "generer-banniere-readme": "node scripts/generer-banniere-readme.mjs",



    "clear": "docusaurus clear",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unist-util-visit-parents": "^3.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "playwright": "^1.63.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
